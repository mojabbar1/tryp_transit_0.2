{
  "components": {
    "schemas": {
      "AlertOut": {
        "description": "An active service alert. Its text is untrusted third-party data (02 §7.3): show it as plain text only.\n\n``header_text``, ``description_text``, and ``url`` are the English translation (or else the untagged or\nthe first one). ``url`` is dropped unless it is http(s).",
        "properties": {
          "active_from": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active From"
          },
          "active_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Until"
          },
          "alert_id": {
            "title": "Alert Id",
            "type": "string"
          },
          "cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cause"
          },
          "description_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description Text"
          },
          "effect": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effect"
          },
          "header_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Header Text"
          },
          "route_ids": {
            "items": {
              "type": "string"
            },
            "title": "Route Ids",
            "type": "array"
          },
          "severity_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Severity Level"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "stop_ids": {
            "items": {
              "type": "string"
            },
            "title": "Stop Ids",
            "type": "array"
          },
          "url": {
            "anyOf": [
