{
  "components": {
    "schemas": {
      "FactOut": {
        "description": "A citable fact: the current approved version of its key (02 §6.3).",
        "properties": {
          "confidence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "derived_from": {
            "additionalProperties": true,
            "title": "Derived From",
            "type": "object"
          },
          "evidence": {
            "additionalProperties": true,
            "title": "Evidence",
            "type": "object"
          },
          "geography": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Geography"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Method"
          },
          "period": {
            "$ref": "#/components/schemas/Period"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/FactSource"
            },
            "title": "Sources",
            "type": "array"
          },
          "status": {
            "const": "approved",
            "title": "Status",
            "type": "string"
          },
          "supersedes_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supersedes Id"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "valid_until": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid Until"
          },
          "value_num": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value Num"
          },
          "value_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value Text"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "key",
          "version",
          "supersedes_id",
          "value_num",
          "value_text",
          "unit",
          "geography",
          "period",
          "method",
          "sources",
          "derived_from",
          "evidence",
          "status",
          "confidence",
          "valid_until"
        ],
        "title": "FactOut",
        "type": "object"
      },
      "FactPage": {
        "description": "One page of facts; pass ``next_cursor`` back as ``cursor`` for the next page.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/FactOut"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "FactPage",
        "type": "object"
      },
      "FactSource": {
        "description": "A cited source. ``retrieved`` is the UTC date of the latest successful input run from it, if any.",
        "properties": {
          "attribution": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attribution"
          },
          "retrieved": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retrieved"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "attribution",
          "retrieved"
        ],
        "title": "FactSource",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "description": "``ok``: the database answers and no approved source is stale; ``degraded``: one is stale.",
        "properties": {
          "database": {
            "enum": [
              "ok",
              "unreachable"
            ],
            "title": "Database",
            "type": "string"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceFreshness"
            },
            "title": "Sources",
            "type": "array"
          },
          "status": {
            "enum": [
              "ok",
              "degraded",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database",
          "version",
          "sources"
        ],
        "title": "Health",
        "type": "object"
      },
      "Period": {
        "properties": {
          "end": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End"
          },
          "start": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          }
        },
        "required": [
          "start",
          "end"
        ],
        "title": "Period",
        "type": "object"
      },
      "SourceFreshness": {
        "description": "One row of the ``source_freshness`` view: the reader's only view of ingestion status.",
        "properties": {
          "cadence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cadence"
          },
          "last_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Status"
          },
          "last_success": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Success"
          },
          "source_id": {
            "title": "Source Id",
            "type": "string"
          },
          "stale": {
            "title": "Stale",
            "type": "boolean"
          },
          "stale_after_hours": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stale After Hours"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "status",
          "cadence",
          "stale_after_hours",
          "last_success",
          "last_status",
          "stale"
        ],
        "title": "SourceFreshness",
        "type": "object"
      },
      "SourceOut": {
        "description": "An approved source's public fields, with the attribution clients must show.",
        "properties": {
          "attribution_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attribution Text"
          },
          "cadence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cadence"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "license": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "terms_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Terms Url"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "url",
          "license",
          "terms_url",
          "attribution_text",
          "cadence"
        ],
        "title": "SourceOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Read-only API over approved sources and facts, plus source freshness (see 02 §6).",
    "title": "Tryp Transit data agent",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/facts": {
      "get": {
        "description": "Current approved facts only, ordered by id; never candidate, rejected, needs_review, or superseded.",
        "operationId": "facts_v1_facts_get",
        "parameters": [
          {
            "in": "query",
            "name": "key_prefix",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Key Prefix"
            }
          },
          {
            "in": "query",
            "name": "geography",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Geography"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FactPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Facts",
        "tags": [
          "facts"
        ]
      }
    },
    "/v1/health": {
      "get": {
        "description": "Database ping plus per-source freshness from the ``source_freshness`` view.",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/sources": {
      "get": {
        "description": "Approved sources only, with their attribution text.",
        "operationId": "sources_v1_sources_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SourceOut"
                  },
                  "title": "Response Sources V1 Sources Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Sources",
        "tags": [
          "sources"
        ]
      }
    }
  }
}
