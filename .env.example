# Local development only. Copy to .env (gitignored) and set every empty password below.
# Generate each one, for example: openssl rand -hex 24
# Use URL-safe characters only (letters, digits, - _ .): the passwords are embedded in postgresql:// URLs.
# compose refuses to start while a password is empty, so there are no shared default passwords.

POSTGRES_DB=tryp
POSTGRES_USER=postgres
POSTGRES_PORT=5432
TDA_API_PORT=8081

# The Postgres superuser (container bootstrap only; the data agent never uses it).
POSTGRES_PASSWORD=
# Roles created by docker/postgres/init/01-roles.sql on the first start of the volume.
# Changing them later needs ALTER ROLE (or `docker compose down -v`, which deletes local data).
TDA_OWNER_PASSWORD=
TDA_WRITER_PASSWORD=
TDA_READER_PASSWORD=

# Host-side URLs for running `uv run tda ...` from data_agent/ (compose builds its own in-network URLs).
# Plain postgresql:// URLs: the code adds the driver.
TDA_ADMIN_DATABASE_URL=postgresql://tda_owner:${TDA_OWNER_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
TDA_DATABASE_URL=postgresql://tda_writer:${TDA_WRITER_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
TDA_READER_DATABASE_URL=postgresql://tda_reader:${TDA_READER_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
