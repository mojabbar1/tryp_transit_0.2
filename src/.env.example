# Server-only settings are read through src/lib/env.ts (zod-validated; blank = unset/default).

# Narration provider: gemini | openai | none. Unset = the legacy USE_GEMINI rule ("true" -> gemini, else openai).
# A selected provider without a key falls back to "none": deterministic template narration.
LLM_PROVIDER=
USE_GEMINI="true"
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional model overrides; leave blank for the D-4 defaults (gemini-3.8-flash / gpt-5.6-terra)
GEMINI_MODEL=
OPENAI_MODEL=
# Narration deadline in ms (1-60000); on timeout the template is used
LLM_TIMEOUT_MS=8000

# TomTom API for traffic and routing (server-only; the legacy NEXT_PUBLIC_TOMTOM_API_KEY name is still read as a fallback)
TOMTOM_API_KEY=
# Arrival times ("HH:MM") resolve in this IANA time zone
REGION_TIMEZONE=America/New_York
# Data agent (unused until P4)
DATA_AGENT_BASE_URL=

# Demo scenarios and demo-only copy; client-readable and never gates a secret. Default off.
# Next.js inlines NEXT_PUBLIC_ values at build time: restart `npm run dev` or rebuild after changing it.
NEXT_PUBLIC_DEMO_MODE=false

# Development settings
# NODE_ENV="development"
